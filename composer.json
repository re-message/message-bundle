{
    "name": "remessage/message-bundle",
    "description": "Message Standard Bundle for Symfony",
    "type": "symfony-bundle",
    "license": "Apache-2.0",
    "homepage": "https://dev.remessage.ru/packages/message-bundle",
    "authors": [
        {
            "name": "Oleg Kozlov",
            "email": "h1karo@remessage.ru",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "RM\\Bundle\\MessageBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RM\\Bundle\\MessageBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",

        "remessage/message": "^1.0.0",

        "symfony/event-dispatcher": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "symfony/browser-kit": "^7.3",
        "symfony/phpunit-bridge": "^7.3",

        "friendsofphp/php-cs-fixer": "^3.16",
        "remessage/ruleset": "^1.3.1",

        "roave/security-advisories": "dev-latest"
    },
    "config": {
        "sort-packages": false
    },
    "scripts": {
        "lint": "PHP_CS_FIXER_IGNORE_ENV=true php-cs-fixer fix --show-progress=dots",
        "lint:ci": "PHP_CS_FIXER_IGNORE_ENV=true php-cs-fixer fix --dry-run -v --show-progress=dots --diff",
        "test": "simple-phpunit"
    }
}
